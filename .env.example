# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/gamefm"

# ─── Auth (NextAuth.js) ─────────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ─── Discord OAuth (for user login) ─────────────────────────────────────────
AUTH_DISCORD_ID="your-discord-app-client-id"
AUTH_DISCORD_SECRET="your-discord-app-client-secret"

# ─── IGDB / Twitch API ──────────────────────────────────────────────────────
TWITCH_CLIENT_ID="your-twitch-client-id"
TWITCH_CLIENT_SECRET="your-twitch-client-secret"

# ─── Discord Bot ─────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN="your-bot-token"
DISCORD_CLIENT_ID="your-bot-client-id"
DISCORD_GUILD_ID=""
BOT_SECRET="shared-secret-between-bot-and-web"

# ─── App URL (used by the bot to call the web API) ──────────────────────────
NEXT_PUBLIC_URL="http://localhost:3000"

# ─── Redis (optional, for caching) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
