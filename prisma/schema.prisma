generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core App Models ─────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  username      String?  @unique
  email         String?  @unique
  emailVerified DateTime?
  name          String?           // display name (NextAuth standard field)
  image         String?           // avatar URL (NextAuth standard field)
  bio           String?
  discordId     String?  @unique
  steamId       String?  @unique
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     GameSession[]
  logs         GameLog[]
  lists        List[]
  following    Follow[]      @relation("Following")
  followers    Follow[]      @relation("Followers")
  activities   Activity[]
  likes        Like[]
  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsSent     Notification[] @relation("NotificationsSent")

  // NextAuth
  accounts     Account[]
  authSessions Session[]
}

model Game {
  id          String    @id @default(cuid())
  igdbId      Int       @unique
  title       String
  slug        String    @unique
  coverUrl    String?
  summary     String?
  releaseDate DateTime?
  genres      String[]
  platforms   String[]
  developer   String?
  publisher   String?
  igdbRating  Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions  GameSession[]
  logs      GameLog[]
  listItems ListItem[]
}

// A single play session — the "scrobble" equivalent
model GameSession {
  id           String        @id @default(cuid())
  userId       String
  gameId       String
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  durationMins Int?
  platform     String?
  source       SessionSource @default(MANUAL)
  isNowPlaying Boolean       @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

enum SessionSource {
  MANUAL
  STEAM
  RICH_PRESENCE
}

// Diary entry — the Letterboxd equivalent
model GameLog {
  id          String     @id @default(cuid())
  userId      String
  gameId      String
  status      GameStatus @default(PLAYING)
  rating      Float? // 0.5 – 5.0
  review      String?
  playedOn    DateTime?  // diary date — when the user played/completed it
  completedAt DateTime?
  isReplay    Boolean    @default(false)
  isSpoiler   Boolean    @default(false)
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tags GameLogTag[]
  likes Like[]

  @@unique([userId, gameId])
}

enum GameStatus {
  PLAYING
  COMPLETED
  DROPPED
  BACKLOG
  WISHLIST
  SHELVED
}

model List {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  isBacklog   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
  likes Like[]
}

model ListItem {
  id       String   @id @default(cuid())
  listId   String
  gameId   String
  position Int
  notes    String?
  addedAt  DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([listId, gameId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Activity {
  id          String       @id @default(cuid())
  userId      String
  type        ActivityType
  referenceId String
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ActivityType {
  SESSION_START
  GAME_LOG
  REVIEW
  LIST_CREATE
  LIST_ADD
  FOLLOW
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  logTags GameLogTag[]
}

model GameLogTag {
  logId String
  tagId String

  log GameLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  tag Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([logId, tagId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  logId     String?
  listId    String?
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  log  GameLog? @relation(fields: [logId], references: [id], onDelete: Cascade)
  list List?    @relation(fields: [listId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           // recipient
  type        NotificationType
  actorId     String?          // who triggered it
  referenceId String?          // related entity (logId, listId, etc.)
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user  User  @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  FOLLOW
  LIKE_REVIEW
  LIKE_LIST
}

// ─── NextAuth Models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}